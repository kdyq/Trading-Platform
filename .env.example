APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://app_user:replace-me@127.0.0.1:5432/campus_trading_platform
REDIS_URL=redis://127.0.0.1:6379/0
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_VERIFICATION_SECRET=replace-with-another-random-secret
AUTH_REGISTRATION_ENABLED=true
AUTH_USER_AGREEMENT_VERSION=development-placeholder
AUTH_PRIVACY_POLICY_VERSION=development-placeholder
QQ_SMTP_USERNAME=replace-with-your-qq-email@qq.com
QQ_SMTP_AUTH_CODE=replace-with-qq-mail-authorization-code
QQ_SMTP_FROM_NAME=拾光集市
